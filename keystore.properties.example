# Copy this file to keystore.properties (gitignored - never commit real
# secrets) to sign local release builds with your real upload key instead of
# falling back to the debug key. In CI, the same four values are supplied via
# GitHub Actions secrets/env vars instead - see
# .github/workflows/release.yml and README "Release & Play Store submission".
storeFile=/absolute/path/to/release-upload-key.jks
storePassword=changeit
keyAlias=upload
keyPassword=changeit
